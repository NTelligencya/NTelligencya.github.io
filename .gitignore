.idea/

# Local
*.log

# Source material archive — original Tennant Creek (TC) pages, old host styling.
# Converted versions live in /digital-literacy/; keep the originals unpublished.
digitalliteracy/

# Claude Code session state. Written per folder, local to the machine, and
# nothing to do with the site.
.claude/

# Staging for files awaiting deletion. Cowork's device bridge cannot delete
# files in a connected folder, so it moves them here instead; empty it in Finder.
_to_delete/

# Design bundles delivered as archives. Large, and it is the unpacked folder
# that gets used, so the zip does not need to be in the repo. No .zip is
# tracked today; if a course ever ships one as a download, un-ignore it with
# a !path line below this one.
*.zip
